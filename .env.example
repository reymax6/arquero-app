# Copy this to .env and fill it in, or set these in your hosting dashboard.
# Nothing here is read from a .env file automatically — pass them as real
# environment variables (Render, Railway and Docker all do this for you).

# --- Required in production -------------------------------------------

# The staff password for /admin. If unset, the server invents a random one
# at startup and prints it — fine on your laptop, useless on a server.
ADMIN_PASSWORD=change-me-to-something-long

# Signs staff login sessions. If unset it's random per restart, which signs
# everyone out every time the app redeploys. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# --- Optional ---------------------------------------------------------

# Staff username (default: admin)
# ADMIN_USER=frontdesk

# Where the SQLite file lives. On a host with a persistent disk mounted at
# /data, point it there so the database survives restarts and deploys.
# DB_PATH=/data/arquero.db

# Port to listen on (default: 3000). Most hosts set this for you.
# PORT=3000

# Where `npm run backup` writes to (default: ./backups)
# BACKUP_DIR=/data/backups
